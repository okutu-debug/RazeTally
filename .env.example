# Copy this file to .env and fill in real values. .env is git-ignored —
# never commit real secrets to this repo.

# Database (defaults shown are what db.py falls back to if unset)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=tallydb

# Required for AI-powered form extraction (parser.py, api.py /upload)
ANTHROPIC_API_KEY=

# Required in production — signs/verifies login JWTs (auth.py). If unset, a
# random key is generated per process, which invalidates all sessions on
# every restart and makes tokens from viz_app.py/api.py mutually invalid.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to "true" once served over HTTPS, to mark the auth cookie Secure.
# Leave "false" for local http:// development.
COOKIE_SECURE=false

# Comma-separated origins allowed to call api.py's public endpoints from a
# browser — this covers the outward-facing/ React app's full surface:
# GET /dashboard/summary, GET /job-descriptions*, POST /apply,
# GET /campaign-routes*, GET /campaign-location-media/*, POST /party-members,
# GET /form-types, GET /forms*, GET /votes*, GET /tally*,
# GET /counties/all, GET /constituencies/all, GET /wards/all,
# GET /feed/posts, GET /feed/posts/*/comments, GET /feed/images/*,
# POST /contributions/mpesa, GET /contributions/mpesa/*, POST /contributions/paypal*,
# GET /contributions/summary, GET /contributions/public-list.
# Leave empty to block all cross-origin browser access.
# For local development with `npm run dev` (Vite default port):
# PUBLIC_CORS_ORIGINS=http://localhost:5173
PUBLIC_CORS_ORIGINS=

# Base URL the Streamlit app (viz_app.py) is served at — used to build the
# PayPal return/cancel redirect URLs from pages/membership/funds.py. Falls
# back to http://localhost:8501 for local dev if unset.
APP_BASE_URL=http://localhost:8501

# Base URL the outward-facing/ React app is served at — used by api.py to
# build PayPal's return/cancel redirect URLs (.../donate?paypal_action=...)
# for the public POST /contributions/paypal endpoint. Required for public
# PayPal donations to work; no default (donations fail loudly if unset).
# e.g. OUTWARD_FACING_URL=https://apply.yourparty.org
OUTWARD_FACING_URL=

# ── M-Pesa (Safaricom Daraja STK Push) — pages/membership/funds.py, api.py ──
# "sandbox" (default) or "production"
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Lipa Na M-Pesa online shortcode — sandbox default below is Safaricom's
# shared test shortcode
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Must be a publicly reachable HTTPS URL (e.g. via ngrok in local dev) that
# routes to api.py's POST /contributions/mpesa/callback
MPESA_CALLBACK_URL=

# ── PayPal (Orders v2 API) — pages/membership/funds.py, api.py ──────────────
# "sandbox" (default) or "live"
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Currently unused by any code path (kept here for future use only):
# OPENAI_API_KEY=
# GROQ_API_KEY=
